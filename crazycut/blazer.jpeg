        .resume-review-toast {
          z-index: 1002;
          white-space: nowrap;
          backdrop-filter: blur(50px);
          border-radius: 8px;
          padding: 12px;
          font-family: Inter, sans-serif;
          font-size: 13px;
          line-height: 16px;
          animation: .2s resume-review-toast-in;
          position: fixed;
          top: 24px;
          left: 50%;
          transform: translate(-50%)
        }

        .resume-review-toast-success {
          color: #000;
          background: #00f0a099;
          box-shadow: 0 6px 24px #00d28c33
        }

        .resume-review-toast-error {
          color: #000;
          background: #ff465a99;
          box-shadow: 0 6px 24px #ff465a33
        }

        @keyframes resume-review-toast-in {
          0% {
            opacity: 0;
            transform: translate(-50%)translateY(-8px)
          }

          to {
            opacity: 1;
            transform: translate(-50%)translateY(0)
          }
        }

