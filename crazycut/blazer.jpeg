        }

        .tailor-resume-loading-linear-progress {
          z-index: 0;
          background: var(--deepgrey-10, #828ca01a);
          border-radius: 2px;
          width: 240px;
          max-width: 100%;
          height: 2px;
          display: block;
          position: relative;
          overflow: hidden
        }

        .tailor-resume-loading-linear-progress-first {
          transform-origin: 0;
          background: var(--Black, #000);
          border-radius: 2px;
          width: auto;
          transition: transform .2s linear;
          animation: 2.1s cubic-bezier(.65, .815, .735, .395) infinite animation-first;
          position: absolute;
          top: 0;
          bottom: 0;
          left: 0
        }

        .tailor-resume-loading-linear-progress-second {
          transform-origin: 0;
          background: var(--Black, #000);
          border-radius: 2px;
          width: auto;
          transition: transform .2s linear;
          animation: 2.1s cubic-bezier(.165, .84, .44, 1) 1.15s infinite animation-second;
          position: absolute;
          top: 0;
          bottom: 0;
          left: 0
        }

        @keyframes animation-first {
          0% {
            left: -35%;
            right: 100%
          }

          60% {
            left: 100%;
            right: -90%
          }

          to {
            left: 100%;
            right: -90%
          }
        }

        @keyframes animation-second {
          0% {
            left: -200%;
            right: 100%
          }

          60% {
            left: 107%;
            right: -8%
          }

          to {
            left: 107%;
            right: -8%
          }
        }

