        .feedback-button {
          width: 32px;
          color: var(--Black, #000);
          text-align: center;
          background: #fff;
          border: none;
          flex-direction: column;
          justify-content: center;
          align-items: center;
          gap: 10px;
          padding: 4px 0;
          font-size: 13px;
          font-weight: 500;
          line-height: 16px;
          display: flex;
          box-shadow: 0 2px 4px #00000005
        }

        .feedback-scale {
          color: #00000073;
          justify-content: space-between;
          align-items: center;
          font-size: 13px;
          font-weight: 400;
          line-height: 16px
        }

        .rate-button.rate-button-overwrite {
          background: #fff;
          border: none;
          border-radius: 4px;
          outline: 1px solid #828ca01a;
          justify-content: center;
          align-items: center;
          transition: none;
          display: flex
        }

        .rate-button.rate-button-overwrite.rate-button-hightlight {
          background: var(--green-30, #00f0a04d) !important;
          border: none !important;
          outline: none !important
        }

        .external-job-entry-container {
          background: var(--base-color-primarybg, #fff);
          width: 100%;
          box-shadow: inset 0 0 0 .5px var(--base-color-grey, #f3f4f5);
          cursor: pointer;
          border-radius: 12px;
          flex-direction: column;
          justify-content: center;
          align-items: center;
          gap: 12px;
          padding: 48px 0;
          display: flex;
          position: relative;
          overflow: hidden
        }

        .external-job-entry-pill {
          background: var(--primary-color-25, #00f0a040);
          border-radius: 20px;
          justify-content: center;
          align-items: center;
          gap: 4px;
          height: 40px;
          padding: 0 16px;
          display: flex;
          position: relative;
          overflow: visible
        }

        .external-job-entry-pill-wrapper {
          display: inline-flex;
          position: relative
        }

        .external-job-entry-pill-text {
          color: var(--Black, #000);
          text-transform: capitalize;
          white-space: nowrap;
          font-size: 13px;
          font-weight: 600;
          line-height: 16px
        }

        .external-job-entry-aistar {
          z-index: 1;
          pointer-events: none;
          position: absolute;
          top: -4px;
          right: 0
        }

        .external-job-entry-text-hint {
          color: var(--Black, #000);
          text-align: center;
          white-space: nowrap;
          font-size: 13px;
          font-weight: 400;
          line-height: 16px
        }

        .external-job-back-home-button {
          cursor: pointer;
          background: #f3f4f5;
          border-radius: 12px;
          flex: none;
