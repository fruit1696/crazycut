        .autofill-info-modal .ant-modal-content {
          border-radius: 24px;
          padding: 0;
          overflow: hidden
        }

        .autofill-info-modal .ant-modal-close {
          color: #000;
          width: 16px;
          height: 16px;
          padding: 0;
          line-height: 1;
          top: 24px;
          right: 24px
        }

        .autofill-info-modal .ant-modal-close:hover {
          background: 0 0 !important
        }

        .autofill-info-modal .ant-modal-close .ant-modal-close-x {
          font-size: 16px;
          line-height: 16px
        }

        .autofill-info-modal .ant-modal-body {
          background: #fff;
          flex-direction: column;
          height: 672px;
          display: flex
        }

        .autofill-info-modal .ant-spin-nested-loading,
        .autofill-info-modal .ant-spin-container {
          flex-direction: column;
          flex: 1;
          min-height: 0;
          display: flex
        }

        .autofill-info-modal .autofill-info-modal-header {
          border-bottom: 1px solid #f3f4f5;
          min-height: 64px;
          padding: 20px 24px
        }

        .autofill-info-modal .autofill-info-modal-header .autofill-info-modal-title {
          color: #000;
          font-size: 16px;
          font-weight: 700;
          line-height: 24px
        }

        .autofill-info-modal .autofill-info-modal-tip {
          background: #f7f8f9;
          border-bottom: 1px solid #f3f4f5;
          padding: 8px 12px
        }

        .autofill-info-modal .autofill-info-modal-tip .autofill-info-modal-tip-text {
          color: #000;
          font-size: 13px;
          font-weight: 400;
          line-height: 16px
        }

        .autofill-info-modal .autofill-info-modal-content {
          flex: 1;
          min-height: 0;
          overflow: hidden
        }

        .autofill-info-modal .autofill-info-modal-sidebar {
          border-right: 1px solid #f3f4f5;
          width: 272px;
          padding: 24px 20px 24px 24px
        }

        .autofill-info-modal .autofill-info-modal-nav-item {
          width: 100%;
          height: 48px;
          box-shadow: none;
          color: #000;
          text-align: left;
          background: 0 0;
          border: none;
          border-radius: 12px;
          justify-content: space-between;
          align-items: center;
          padding: 0 12px;
          font-size: 13px;
          font-weight: 600;
          line-height: 16px;
          display: flex
        }

        .autofill-info-modal .autofill-info-modal-nav-item:hover {
          color: #000 !important;
          background: #f7f8f9 !important
        }

        .autofill-info-modal .autofill-info-modal-nav-item.is-active {
          background: #f3f4f5
        }

        .autofill-info-modal .autofill-info-modal-nav-dot {
          vertical-align: middle;
          background: #ff465a;
          border-radius: 50%;
          flex-shrink: 0;
          width: 8px;
          height: 8px;
          margin-left: 4px;
          display: inline-block
        }

        .autofill-info-modal .autofill-info-modal-main {
          overscroll-behavior: contain;
          scrollbar-width: none;
          flex: 1;
          min-width: 0;
          min-height: 0;
          padding: 24px;
          overflow-y: auto
        }

        .autofill-info-modal .autofill-info-modal-main::-webkit-scrollbar {
          display: none
        }

        .autofill-info-modal .autofill-info-modal-panel {
          gap: 24px;
          width: 100%
        }

        .autofill-info-modal .autofill-info-modal-personal-grid {
          grid-template-columns: repeat(6, 1fr);
          gap: 24px 8px;
          width: 100%;
          display: grid
        }

        .autofill-info-modal .autofill-info-modal-personal-divider {
          background: #0000000a;
          grid-column: 1/-1;
          height: 1px
        }

        .autofill-info-modal .autofill-info-modal-personal-col-name {
          grid-column: span 2
        }

        .autofill-info-modal .autofill-info-modal-personal-col2 {
          grid-column: span 3
        }

        .autofill-info-modal .autofill-info-modal-personal-col4 {
          grid-column: span 6
        }

        .autofill-info-modal .autofill-info-modal-personal-col-phone {
          grid-column: span 4;
          min-width: 0
        }

        .autofill-info-modal .autofill-info-modal-phone-control {
          width: 100%
        }

        .autofill-info-modal .autofill-info-modal-phone-input {
          width: 100%;
          height: 40px;
          box-shadow: none;
          color: #000;
          background: #f7f8f9;
          border: none;
          border-radius: 8px;
          font-family: inherit;
          font-size: 13px;
          line-height: 40px
        }

        .autofill-info-modal .autofill-info-modal-phone-input::placeholder {
          color: #00000073
        }

        .autofill-info-modal .autofill-info-modal-phone-input:focus {
          box-shadow: none;
          outline: none
        }

        .autofill-info-modal .autofill-info-modal-card {
          background: 0 0;
          border: none;
          border-radius: 0;
          width: 100%;
          padding: 0 0 24px;
          position: relative
        }

        .autofill-info-modal .autofill-info-modal-card:after {
          content: "";
          background-color: #0000000a;
          width: 100%;
          height: 1px;
          position: absolute;
          bottom: 0;
          left: 0
        }

        .autofill-info-modal .autofill-info-modal-card:last-of-type:after {
          bottom: 0
        }

        .autofill-info-modal .autofill-info-modal-card-header {
          margin-bottom: 12px
        }

        .autofill-info-modal .autofill-info-modal-card-title {
          color: #000;
          font-size: 20px;
          font-weight: 700;
          line-height: 24px
        }

        .autofill-info-modal .autofill-info-modal-delete {
          border: 1px solid var(--base-color-lightgrey, #f7f8f9);
          background: var(--base-color-lightgrey, #f7f8f9);
          color: #000;
          width: 32px;
          min-width: 32px;
          height: 32px;
          box-shadow: none;
          border-radius: 16px;
          justify-content: center;
          align-items: center;
          padding: 0;
          transition: all .2s ease-in-out;
          display: flex
        }

        .autofill-info-modal .autofill-info-modal-delete .ant-btn-icon {
          justify-content: center;
          align-items: center;
          width: 16px;
          height: 16px;
          line-height: 0;
          display: flex
        }

        .autofill-info-modal .autofill-info-modal-delete:hover,
        .autofill-info-modal .autofill-info-modal-delete:focus,
        .autofill-info-modal .autofill-info-modal-delete:active {
