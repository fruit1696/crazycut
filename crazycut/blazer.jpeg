          padding-bottom: 12px !important;
          line-height: 16px !important
        }

        .autofill-info-modal .autofill-info-modal-control.ant-input::placeholder,
        .autofill-info-modal .autofill-info-modal-control .ant-select-selection-placeholder,
        .autofill-info-modal .autofill-info-modal-control .ant-select-selection-item {
