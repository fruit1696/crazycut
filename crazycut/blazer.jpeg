      </style>
      <style id="jobright-helper-style">
        .ant-message .ant-message-notice {
          padding: 0
        }

        .ant-message .ant-message-notice .ant-message-notice-content {
          background: #7df5cd;
          border-radius: 8px;
          justify-content: center;
          align-items: center;
          padding: 12px;
          display: inline-flex;
          box-shadow: 0 6px 24px #00d28c33
        }

        .ant-drawer .ant-drawer-content-wrapper .ant-drawer-content .ant-drawer-close {
          border: 1px solid var(--Grey, #f2f4f5);
          margin: 0;
          border-radius: 8px;
          flex-shrink: 0;
          justify-content: center;
          align-items: center;
          width: 32px;
          height: 32px;
          margin-inline-end: 16px;
          padding: 0;
          display: flex
        }

        .ant-drawer .ant-drawer-content-wrapper .ant-drawer-content .ant-drawer-body {
          padding: 0
        }

        .ant-divider.ant-divider-horizontal {
          margin: 0
        }

        .handle {
          background: #fff;
          border-radius: 48px 0 0 48px;
          transition: transform .5s;
          transform: translate(24px)
        }

        .handle:hover {
          transform: translate(0)
        }

        .handle:hover .close-button-wrapper {
          visibility: visible
        }

        .handle:has(.close-button-wrapper[data-open=true]) {
          transform: translate(0)
        }

        .bird-button {
          cursor: pointer;
          padding: 8px;
          position: relative
        }

        .close-button-wrapper {
          cursor: pointer;
          visibility: hidden;
          box-sizing: border-box;
          background: #fff;
          border-radius: 10px;
          flex-shrink: 0;
          justify-content: center;
          align-items: center;
          width: 20px;
          height: 20px;
          padding: 4px;
          display: flex;
          position: absolute;
          top: 0;
          left: 0;
          box-shadow: 0 0 4px #0003
        }

        .close-button-wrapper[data-open=true] {
          visibility: visible
        }

        .hide-menu-popup {
          background: var(--base-color-primarybg, #fff);
          border-radius: 8px;
          flex-direction: column;
          gap: 2px;
          width: 160px;
          padding: 4px;
          font-family: Inter;
          display: flex;
          box-shadow: 0 32px 80px #000a144d
        }

        .hide-menu-popup .hide-menu-item {
          cursor: pointer;
          color: #000;
          user-select: none;
          border-radius: 4px;
          align-self: stretch;
          align-items: center;
          gap: 8px;
          height: 36px;
          padding: 0 8px;
          font-size: 14px;
          line-height: 20px;
          display: flex
        }

        .hide-menu-popup .hide-menu-item:hover {
          background: var(--primary-color-25, #00f0a040)
        }

        @keyframes slideIn {
          0% {
            right: -100px
          }

          to {
            right: 0
          }
        }

