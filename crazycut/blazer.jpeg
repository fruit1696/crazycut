        #jr_linkedin_banner .linkedin-banner-container {
          flex-direction: column;
          justify-content: center;
          align-items: center;
          width: 100%;
          height: 140px;
          display: flex
        }

        #jr_linkedin_banner .linkedin-banner-container .banner-dashboard {
          flex-direction: row;
          justify-content: center;
          align-items: center;
          gap: 12px;
          padding: 16px;
          display: flex
        }

        #jr_linkedin_banner .linkedin-banner-container .banner-dashboard-tips-area {
          flex-direction: column;
          justify-content: center;
          align-items: center;
          gap: 4px;
          display: flex
        }

        #jr_linkedin_banner .linkedin-banner-container .banner-dashboard-ring-area {
          border: 1px solid #f3f4f6
        }

        #jr_linkedin_banner .custom-progress-container {
          gap: 8px
        }

        #jr_linkedin_banner .custom-progress-container .custom-progress {
          width: 128px;
          height: 64px;
          position: relative
        }

        #jr_linkedin_banner .custom-progress-container .custom-progress .custom-progress-bar {
          transform-origin: 0 0;
          background-color: #0000;
          width: 64px;
          height: 0;
          position: absolute;
          top: 100%;
          left: 50%
        }

        #jr_linkedin_banner .custom-progress-container .custom-progress .custom-progress-bar .custom-progress-dot {
          background-color: #fff;
          border: 2px solid #000;
          border-radius: 50%;
          width: 14px;
          height: 14px;
          position: absolute;
          top: 50%;
          right: 0;
          transform: translate(24%, -50%)
        }

        #jr_linkedin_banner .custom-progress-container .custom-progress .custom-progress-score {
          color: #000;
          font-size: 40px;
          font-weight: 700;
          line-height: 40px;
          position: absolute;
          bottom: -5px;
          left: 50%;
          transform: translate(-50%)
        }

        #jr_linkedin_banner .custom-progress-container .custom-progress-level {
          background: #f2f4f5;
          border-radius: 2px 2px 8px 8px;
          justify-content: center;
          align-items: center;
          gap: 10px;
          width: 128px;
          height: 24px;
          padding: 2px 4px;
          font-size: 13px;
          font-weight: 700;
          line-height: 16px;
          display: flex;
          position: relative
        }

        #jr_linkedin_banner .custom-progress-container .custom-progress-level-info {
          position: absolute;
          right: 6px
        }

        .insider-connections {
          cursor: pointer;
          border-top: 1px solid #0000000a;
          width: 100%;
          padding-top: 12px
        }

        .insider-connections .insider-connections-title {
          color: var(--Black, #000);
          text-transform: capitalize;
          font-size: 13px;
          font-weight: 600;
          line-height: 16px
        }

        .insider-connections .insider-connections-right {
          gap: 0
        }

        .insider-connections .insider-connections-avatars {
          align-items: center;
          padding-right: 2px;
          display: flex
        }

        .insider-connections .insider-connections-avatar {
          background: #90fadc;
          border-radius: 20px;
          justify-content: center;
          align-items: center;
          width: 20px;
          height: 20px;
          margin-right: -2px;
          display: flex;
          position: relative;
          overflow: hidden;
          box-shadow: 0 0 0 1px #fff
        }

        .insider-connections .insider-connections-avatar span {
          color: #000;
          text-transform: uppercase;
          text-align: center;
          width: 100%;
          height: 16px;
          font-family: Inter, sans-serif;
          font-size: 11px;
          font-weight: 400;
          line-height: 16px;
          position: absolute;
          top: calc(50% - 8px);
          left: 50%;
          transform: translate(-50%)
        }

        .insider-connections .insider-connections-avatar-more {
          box-sizing: border-box;
          background: #90fadc;
          width: auto;
          min-width: 20px;
          padding: 0 4px
        }

        .insider-connections .insider-connections-avatar-more span {
          width: auto;
          height: auto;
          position: static;
          top: auto;
          left: auto;
          transform: none
        }

        .autofill-tips {
