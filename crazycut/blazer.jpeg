        }

        .autofill-info-modal .autofill-info-modal-delete-confirm-text {
          color: #000;
          white-space: nowrap;
          font-size: 12px;
          font-weight: 500;
          line-height: 24px
        }

        .autofill-info-modal .autofill-info-modal-delete-confirm-btn {
          cursor: pointer;
          background: #fff;
          border: none;
          border-radius: 12px;
          justify-content: center;
          align-items: center;
          width: 24px;
          min-width: 24px;
          height: 24px;
          padding: 0;
          display: flex
        }

        .autofill-info-modal .autofill-info-modal-delete-confirm-btn:hover {
          background: #f2f4f5
        }

        .autofill-info-modal .autofill-info-modal-field-group {
          width: 100%
        }

        .autofill-info-modal .autofill-info-modal-label {
          color: #000;
          font-size: 13px;
          font-weight: 600;
          line-height: 16px
        }

        .autofill-info-modal .autofill-info-modal-label-required {
