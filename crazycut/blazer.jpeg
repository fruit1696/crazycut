        .resume-loading-container {
          background: #fff;
          border-radius: 20px;
          justify-content: center;
          align-items: center;
          width: 480px;
          padding: 48px 60px;
          display: flex
        }

        .resume-loading-container-bordered {
          box-shadow: inset 0 0 0 .5px #0000000f
        }

        .resume-loading-container .resume-loading-linear-progress {
          z-index: 0;
          border-radius: 2px;
          position: relative;
          overflow: hidden;
          background: var(--base-color-grey) !important;
          flex-shrink: 0 !important;
          width: 360px !important;
          min-width: 360px !important;
          height: 2px !important;
          min-height: 2px !important;
          display: block !important
        }

        .resume-loading-container .resume-loading-linear-progress-first {
          transform-origin: 0;
          background: #000;
          border-radius: 2px;
          width: auto;
          transition: transform .2s linear;
          animation: 2.1s cubic-bezier(.65, .815, .735, .395) infinite animation-first;
          position: absolute;
          top: 0;
          bottom: 0;
          left: 0
        }

        .resume-loading-container .resume-loading-linear-progress-second {
          transform-origin: 0;
          background: #000;
          border-radius: 2px;
          width: auto;
          transition: transform .2s linear;
          animation: 2.1s cubic-bezier(.165, .84, .44, 1) 1.15s infinite animation-second;
          position: absolute;
          top: 0;
          bottom: 0;
          left: 0
        }

        .resume-loading-container .resume-loading-title {
          max-width: 320px;
          color: var(--base-color-black);
          text-align: center;
          text-transform: capitalize;
          font-size: 16px;
          font-weight: 600;
          line-height: 24px;
