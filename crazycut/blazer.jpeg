          border-color: var(--base-color-lightgrey, #f7f8f9) !important;
          background: var(--base-color-lightgrey, #f7f8f9) !important;
          box-shadow: none !important
        }

        .autofill-info-modal .autofill-info-modal-delete-confirm {
          background: #ff465a1a;
          border-radius: 16px;
