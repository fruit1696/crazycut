          margin-top: 0
        }

        .cover-letter-review-container .cover-letter-review-content {
          flex: 1;
          align-items: stretch;
          min-height: 0
        }

        .cover-letter-review-container .cover-letter-review-left {
          flex-direction: column;
          flex: 0 0 400px;
          width: 400px;
          min-width: 400px;
          max-width: 400px;
          padding: 24px;
          display: flex;
          box-shadow: inset -1px 0 #f3f4f5
        }

        .cover-letter-review-container .cover-letter-review-name-shell {
          background: #f7f8f9;
          border-radius: 8px;
          align-items: center;
          gap: 8px;
          width: 100%;
          height: 40px;
          padding: 0 12px;
          display: flex;
          overflow: hidden
        }

        .cover-letter-review-container .cover-letter-review-name-shell-editing {
          padding: 0 4px 0 12px
        }

        .cover-letter-review-container .cover-letter-review-modal-title {
          color: #000;
          font-size: 16px;
          font-weight: 700;
          line-height: 24px
        }

        .cover-letter-review-container .cover-letter-review-name {
          color: #000;
          flex: 1;
          min-width: 0;
          font-size: 13px;
          line-height: 16px
        }

        .cover-letter-review-container .cover-letter-review-edit {
          color: #000;
          cursor: pointer;
          background: 0 0;
          border: none;
          padding: 0
        }

        .cover-letter-review-container .cover-letter-review-edit-input {
          color: #000;
          flex: 1;
          min-width: 0;
          font-size: 13px;
          line-height: 16px
        }

        .cover-letter-review-container .cover-letter-review-edit-input.ant-input {
          padding-left: 0;
          font-size: 13px;
          line-height: 16px
        }

        .cover-letter-review-toast {
          z-index: 1002;
          white-space: nowrap;
          backdrop-filter: blur(50px);
          border-radius: 8px;
          padding: 12px;
          font-family: Inter, sans-serif;
          font-size: 13px;
          line-height: 16px;
          animation: .2s cover-letter-review-toast-in;
          position: fixed;
          top: 24px;
          left: 50%;
          transform: translate(-50%)
        }

        .cover-letter-review-toast-success {
          color: #000;
          background: #00f0a099;
          box-shadow: 0 6px 24px #00d28c33
        }

        .cover-letter-review-toast-error {
          color: #000;
          background: #ff465a99;
          box-shadow: 0 6px 24px #ff465a33
        }

        @keyframes cover-letter-review-toast-in {
          0% {
            opacity: 0;
            transform: translate(-50%)translateY(-8px)
          }

          to {
            opacity: 1;
            transform: translate(-50%)translateY(0)
          }
        }

        .cover-letter-preview-container {
          overscroll-behavior: contain;
          z-index: 0;
          background: #fff;
          flex-direction: column;
          flex: 1;
          width: 100%;
          min-width: 500px;
          height: 100%;
          min-height: 496px;
          display: flex;
          position: relative;
          overflow: hidden
        }

        .cover-letter-preview-iframe {
          width: 100%;
          height: 100%;
          min-height: 496px;
          box-shadow: none;
          z-index: 1;
          border: none;
          outline: none;
          flex: 1;
          margin: 0;
          padding: 0;
          display: block;
          position: relative;
          background: #fff !important
        }

        .cover-letter-preview-mask {
          pointer-events: none;
          box-sizing: border-box;
          z-index: 999;
          border: 20px solid #fff;
          position: absolute;
          inset: 0
        }

        .update-job-info-link {
          cursor: pointer;
          justify-content: center;
          align-items: center;
          width: 100%;
          padding: 8px 0 4px;
          display: flex
        }

        .update-job-info-link .update-job-info-link-text {
          color: #8c8f93;
          text-underline-offset: 2px;
          font-size: 12px;
          font-weight: 400;
          line-height: 16px;
          text-decoration: underline
        }

        .update-job-info-link:hover .update-job-info-link-text {
          color: #5d6066
        }

        .update-job-info-link.update-job-info-link-disabled {
          cursor: not-allowed
        }

        .update-job-info-link.update-job-info-link-disabled .update-job-info-link-text,
        .update-job-info-link.update-job-info-link-disabled:hover .update-job-info-link-text {
          color: #c5c7ca
        }

        * {
          box-sizing: border-box
        }

