        }

        .autofill-info-modal .autofill-info-modal-control.ant-select-single {
          height: 40px !important
        }

        .autofill-info-modal .autofill-info-modal-control.ant-picker {
          width: 100%;
          box-shadow: none !important;
          color: #000 !important;
          background: #f7f8f9 !important;
