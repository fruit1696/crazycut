        }

        .external-job-back-home-button svg {
          width: 12px;
          height: 12px;
          display: block
        }

        .plugin-setting-header,
        .external-job-form-header {
          background: #fff;
          justify-content: start;
          align-items: center;
          gap: 8px;
          width: 100%;
          padding-bottom: 12px;
          display: flex;
          box-shadow: inset 0 -1px #f3f4f5
        }

        .plugin-setting-header {
          min-height: 48px;
          box-shadow: none;
          flex: 0 0 48px;
          padding: 0 12px
        }

        .external-job-analyze-header {
          width: 100%;
          box-shadow: none;
          background: #fff;
          justify-content: start;
          align-items: center;
          gap: 8px;
          padding: 0 12px;
          display: flex
        }

        .external-job-form-topbar {
          width: 100%;
          box-shadow: none;
          background: #fff;
          border: none;
          justify-content: start;
          align-items: center;
          gap: 8px;
          display: flex
        }

        .plugin-setting-header-title,
        .external-job-form-header-title {
          color: var(--Black, #000);
          font-size: 14px;
          font-weight: 600;
          line-height: 16px
        }

        .plugin-setting-body,
        .external-job-form-body {
          width: 100%
        }

        .plugin-setting-body {
          flex-direction: column;
          flex: 1;
          min-height: 0;
          padding: 12px;
          display: flex;
          overflow-y: auto
        }

        @media (height<=800px) {
          .plugin-setting-body {
            max-height: calc(100vh - 150px);
            position: relative
          }
        }

        .external-job-form-page {
          background: #fff;
          border-radius: 0;
          flex-direction: column;
          justify-content: flex-start;
          align-items: stretch;
          gap: 0;
          width: 100%;
          height: 100%;
          min-height: 0;
          padding: 0;
          font-family: Inter, sans-serif;
          display: flex;
          overflow: hidden
        }

        .external-job-form-topbar {
          flex: 0 0 48px;
          min-height: 48px;
          padding: 0 12px
        }

        .external-job-form-header-title {
          color: #000;
          margin: 0;
          font-size: 14px;
          font-weight: 600;
          line-height: 16px
        }

        .external-job-form-body {
          flex-direction: column;
          flex: 1;
          gap: 24px;
          min-height: 0;
          padding: 0 12px 12px;
          display: flex;
          overflow: hidden
        }

        .external-job-form-tip {
          color: #000;
          text-align: center;
          background: #00f0a01a;
          border-radius: 8px;
          justify-content: center;
          align-items: center;
          width: 100%;
          min-height: 32px;
          padding: 8px;
          font-size: 13px;
          font-weight: 400;
          line-height: 16px;
          display: flex
        }

        .external-job-form-bottom {
          flex: none;
          width: 100%;
          padding: 12px;
          box-shadow: inset 0 1px #f3f4f5
        }

        .external-job-form-submit-button {
          background: var(--Green, #00f0a0);
          cursor: pointer;
          width: 100%;
          height: 40px;
          box-shadow: none;
          appearance: none;
          border: none;
          border-radius: 8px;
          justify-content: center;
          align-items: center;
          display: flex
        }

        @media (height<=800px) {
          .external-job-form-submit-button {
            z-index: 10;
            position: sticky;
            bottom: 0
