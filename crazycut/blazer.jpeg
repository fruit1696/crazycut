          box-shadow: none;
          cursor: pointer;
          background: #00f0a0;
          border: none;
          border-radius: 20px;
          justify-content: center;
          align-items: center;
          padding: 0 32px;
          display: flex
        }

        .external-job-fail-button:hover,
        .external-job-fail-button:focus {
